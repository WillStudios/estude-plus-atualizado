# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE • ESTUDE+ & SUPABASE
# ==============================================================================

# Porta do Servidor Web
PORT=8080

# URL do seu projeto no Supabase (Ex: https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://sua-url-aqui.supabase.co

# Chave Anon / Pública do Supabase (ou Service Role se preferir privilégio total)
SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Senha Mestre do Administrador Freddie Costa
ADMIN_PASSWORD=adm@123

# Ambiente
NODE_ENV=production
